{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "talon_list",
  "rules": {
    "source_file": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PREC_DYNAMIC",
          "value": 2,
          "content": {
            "type": "SYMBOL",
            "name": "headerless"
          }
        },
        {
          "type": "SYMBOL",
          "name": "with_header"
        }
      ]
    },
    "headerless": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "declaration"
      }
    },
    "with_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "matches"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "REPEAT1",
              "content": {
                "type": "STRING",
                "value": "-"
              }
            }
          }
        },
        {
          "type": "SYMBOL",
          "name": "newline"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "declaration"
          }
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "#[^\\r\\n]*?"
      }
    },
    "newline": {
      "type": "PATTERN",
      "value": "\\r?\\n|\\r"
    },
    "matches": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "match"
          }
        }
      ]
    },
    "match_modifier": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "and"
        },
        {
          "type": "STRING",
          "value": "not"
        }
      ]
    },
    "match": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "modifiers",
          "content": {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "match_modifier"
            }
          }
        },
        {
          "type": "FIELD",
          "name": "left",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "FIELD",
          "name": "right",
          "content": {
            "type": "SYMBOL",
            "name": "implicit_string"
          }
        },
        {
          "type": "SYMBOL",
          "name": "newline"
        }
      ]
    },
    "declarations": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "declaration"
      }
    },
    "declaration": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "left",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": ":"
                },
                {
                  "type": "FIELD",
                  "name": "right",
                  "content": {
                    "type": "SYMBOL",
                    "name": "implicit_string"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "newline"
        }
      ]
    },
    "identifier": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "([A-Za-z_][A-Za-z0-9_]*)(\\.[A-Za-z_][A-Za-z0-9_]*)*"
        }
      ]
    },
    "implicit_string": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "(\\S|\\S.*\\S)"
      }
    },
    "string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "string_escape_sequence"
              },
              {
                "type": "SYMBOL",
                "name": "_not_escapesequence"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "string_escape_sequence": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\\"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "u[a-fA-F\\d]{4}"
                },
                {
                  "type": "PATTERN",
                  "value": "U[a-fA-F\\d]{8}"
                },
                {
                  "type": "PATTERN",
                  "value": "x[a-fA-F\\d]{2}"
                },
                {
                  "type": "PATTERN",
                  "value": "\\d{3}"
                },
                {
                  "type": "PATTERN",
                  "value": "\\r?\\n"
                },
                {
                  "type": "STRING",
                  "value": "'"
                },
                {
                  "type": "STRING",
                  "value": "\""
                },
                {
                  "type": "STRING",
                  "value": "a"
                },
                {
                  "type": "STRING",
                  "value": "b"
                },
                {
                  "type": "STRING",
                  "value": "f"
                },
                {
                  "type": "STRING",
                  "value": "r"
                },
                {
                  "type": "STRING",
                  "value": "n"
                },
                {
                  "type": "STRING",
                  "value": "t"
                },
                {
                  "type": "STRING",
                  "value": "v"
                },
                {
                  "type": "STRING",
                  "value": "\\"
                }
              ]
            }
          ]
        }
      }
    },
    "_not_escapesequence": {
      "type": "STRING",
      "value": "\\"
    }
  },
  "extras": [
    {
      "type": "SYMBOL",
      "name": "comment"
    },
    {
      "type": "PATTERN",
      "value": "[\\s\\f\\uFEFF\\u2060\\u200B]|\\\\\\r?\\n"
    }
  ],
  "conflicts": [
    [
      "match",
      "declaration"
    ],
    [
      "headerless",
      "with_header"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}
